{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsrs -b ../../packages/api && tsdown",
    "check-types": "tsrs -b ../../packages/api && tsrs --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen",
    "test": "bun test src"
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@wacheap/api": "workspace:*",
    "@wacheap/auth": "workspace:*",
    "@wacheap/db": "workspace:*",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@wacheap/config": "workspace:*",
    "@wacheap/infra": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
