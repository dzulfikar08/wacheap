# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Cloudflare Turnstile secret for the waitlist. Local dev and tests use Cloudflare's always-pass test secret.
# @type=string(minLength=1)
TURNSTILE_SECRET_KEY=

# --- WACheap Cloud billing (off unless WACHEAP_CLOUD=true; self-hosting never bills) ---
# "true" turns on the trial, the send gate and DOKU checkout. The production stage sets it in alchemy.run.ts.
# @required=false @public @type=enum(true, false)
WACHEAP_CLOUD=false

# DOKU Checkout merchant (DOKU dashboard > Integration > API Keys). Without both keys the deploy still works and
# checkout answers "pembayaran belum disiapkan". DOKU posts payments to <server>/api/billing/webhook, set per checkout.
# @required=false @type=string
DOKU_CLIENT_ID=

# @required=false @type=string
DOKU_SECRET_KEY=

# Empty = production (https://api.doku.com); sandbox: https://api-sandbox.doku.com
# @required=false @public @type=string
DOKU_BASE_URL=
