{
  "name": "@wacheap/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsrs -b",
    "check-types": "tsrs -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "catalog:",
    "libsql": "0.5.29",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@wacheap/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
