{
  "name": "@wab/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsrs -b",
    "check-types": "tsrs -b",
    "test": "bun test src",
    "dev": "tsrs -b --watch"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@wab/auth": "workspace:*",
    "@wab/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@wab/config": "workspace:*",
    "typescript": "catalog:"
  }
}
